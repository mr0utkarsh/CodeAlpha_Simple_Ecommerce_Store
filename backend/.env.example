# ---------------------------------------------------------------------------
# NOVA MART API - copy this file to `.env` and adjust the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma.
#   * Local PostgreSQL:            postgresql://postgres:postgres@localhost:5432/novamart?schema=public
#   * docker-compose (see root):   postgresql://nova:nova@localhost:5432/novamart?schema=public
#   * Embedded dev database:       postgresql://postgres:postgres@127.0.0.1:55432/novamart?schema=public
#                                  (start it with: npm run db:local)
DATABASE_URL="postgresql://nova:nova@localhost:5432/novamart?schema=public"

# Authentication - generate a fresh secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-characters"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Business rules
FREE_SHIPPING_THRESHOLD=150
SHIPPING_FEE=12
